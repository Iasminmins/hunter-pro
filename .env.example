# Copie para .env e preencha localmente. Nunca envie segredos ao Git.
# Use a URL pooled do Neon para a aplicação (host terminado em -pooler).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
APP_PASSWORD_HASH=scrypt$PREENCHA$GERANDO_COM_NPM_RUN_HASH_PASSWORD
SESSION_SECRET=gere-um-valor-aleatorio-com-pelo-menos-32-caracteres
